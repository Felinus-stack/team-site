{
  "name": "team-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node --env-file=.env server/dist/index.js",
    "server:dev": "pnpm run server:build && pnpm run server:start",
    "knowledge:sync": "pnpm run server:build && node --env-file=.env server/dist/scripts/sync-knowledge.js",
    "recruitment:seed": "pnpm run server:build && node --env-file=.env server/dist/scripts/seed-recruitment.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed:admin": "node prisma/create-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@react-google-maps/api": "^2.19.3",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.11",
    "antd": "^6.5.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "express": "^4.19.2",
    "framer-motion": "^11.2.6",
    "next": "14.1.0",
    "nodemailer": "^9.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.50.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "react-scroll": "^1.9.0",
    "react-transition-group": "^4.4.5",
    "tailwindcss-filters": "^3.0.0",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-scroll": "^1.8.10",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.4.35",
    "prisma": "^5.10.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
