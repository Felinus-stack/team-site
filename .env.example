# MySQL connection used by Prisma. Keep real values only in .env.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/team_site"

# Express API and Next.js front end.
API_PORT=4000
API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"

# JWT authentication.
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Cloud LLM (OpenAI-compatible Chat Completions API).
LLM_API_BASE_URL="https://your-provider.example.com/v1"
LLM_API_KEY="replace-with-your-api-key"
LLM_MODEL="your-model-name"

# Local AI services started with docker compose.
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="team_site_knowledge"
OLLAMA_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"

# Reserved for future recruitment notification emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="notifications@example.com"
SMTP_PASS="replace-with-mail-app-password"
MAIL_FROM="源境团队 <notifications@example.com>"
