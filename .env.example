# MySQL connection used by Prisma. Keep the real value only in .env.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/team_site"

# Public Express API used by the Next.js front end.
API_PORT=4000
API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"

# Required by the Express JWT authentication service.
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
