// $ npx prisma db push
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String    @id @default(uuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
}

model Account {
  id                String  @id @default(uuid())
  adminId           String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model TeamMember {
  id          String @id @default(uuid())
  name        String
  surname     String
  phoneNumber String?
  email       String?
  roles       Role[]
}

model Role {
  id          String @id @default(uuid())
  department  String
  role        String
  bolidName   String
  teamMember  TeamMember @relation(fields: [teamMemberId], references: [id])
  teamMemberId String
}

model Bolid {
  id                String @id @default(uuid())
  name              String @unique
  year              String
  shortDescription  String
  enShortDescription String? @db.Text
  parts             Part[]
  acceleration      String
  mass              String
  power             String
}

model Part {
  id          String @id @default(uuid())
  partName    String
  description String
  bolid       Bolid @relation(fields: [bolidId], references: [id])
  bolidId     String
}

model News {
  id                String @id @default(uuid())
  date              DateTime  @default(now())
  title             String
  shortDescription  String
  longDescription   String
  duration          Int
  logo              String
  mainImage         String
  content           NewsContent[]
}

model NewsContent {
  id      String @id @default(uuid())
  text    String
  news    News @relation(fields: [newsId], references: [id])
  newsId  String
}